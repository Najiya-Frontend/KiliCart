NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
# Empty means no forwarded headers are trusted. Set verified proxy IPs/CIDRs only.
TRUSTED_PROXY_CIDRS=
# Production: same 32-byte random secret, hex encoded, on all API instances.
AUTH_RATE_LIMIT_SECRET=
# 32 random bytes as hex; configure the same separately managed key on API and worker.
AUTH_EMAIL_OUTBOX_KEY=
AUTH_EMAIL_WORKER_SECONDS=60
AUTH_EMAIL_LEASE_SECONDS=180
AUTH_EMAIL_BATCH_SIZE=10
AUTH_EMAIL_MAX_ATTEMPTS=5
AUTH_EMAIL_RETENTION_DAYS=7
ACCESS_TOKEN_SECONDS=900
SESSION_SECONDS=2592000
DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/kilicart_dev"
SHADOW_DATABASE_URL="mysql://USERNAME:PASSWORD@localhost:3306/kilicart_shadow"
TEST_DATABASE_URL="mysql://TEST_USERNAME:TEST_PASSWORD@localhost:3306/kilicart_test"
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=YOUR_SANDBOX_USERNAME
SMTP_PASSWORD=YOUR_SANDBOX_PASSWORD
EMAIL_FROM=KiliCart-test@example.invalid
APP_PUBLIC_URL=http://localhost:3000
SMTP_TEST_RECIPIENT=developer@example.invalid

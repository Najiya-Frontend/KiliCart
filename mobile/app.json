{
  "expo": {
    "name": "KiliCart",
    "slug": "kilicart-customer",
    "scheme": "kilicart",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      ["expo-image-picker", { "photosPermission": "Allow KiliCart to select product photos from your library.", "cameraPermission": false, "microphonePermission": false }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.kilicart.customer"
    },
    "ios": {
      "bundleIdentifier": "com.kilicart.customer"
    }
  }
}
